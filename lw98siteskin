.userstuff p {
  padding: 0.2em 0.5em 0.3em 0.6em;
  margin: 0.35em 0;
  border-radius: 12px 5px 14px 4px;
}

.userstuff p:nth-of-type(5n+1) {
  background: rgba(255, 235, 59, 0.45);
  transform: rotate(-0.35deg);
}

.userstuff p:nth-of-type(5n+2) {
  background: rgba(244, 143, 177, 0.40);
  transform: rotate(0.3deg);
}

.userstuff p:nth-of-type(5n+3) {
  background: rgba(129, 212, 250, 0.40);
  transform: rotate(-0.25deg);
}

.userstuff p:nth-of-type(5n+4) {
  background: rgba(165, 214, 167, 0.45);
  transform: rotate(0.4deg);
}

.userstuff p:nth-of-type(5n+5) {
  background: rgba(255, 183, 77, 0.40);
  transform: rotate(-0.3deg);
}

.userstuff p:nth-of-type(4n) {
  background: none;
  transform: none;
  padding: 0;
}

.userstuff ul li,
.userstuff ol li {
  padding: 0.1em 0.4em;
  margin: 0.15em 0;
  border-radius: 10px 4px 12px 3px;
}

.userstuff ul li:nth-of-type(3n+1),
.userstuff ol li:nth-of-type(3n+1) {
  background: rgba(255, 235, 59, 0.35);
}

.userstuff ul li:nth-of-type(3n+2),
.userstuff ol li:nth-of-type(3n+2) {
  background: rgba(129, 212, 250, 0.35);
}

.userstuff ul li:nth-of-type(3n),
.userstuff ol li:nth-of-type(3n) {
  background: rgba(165, 214, 167, 0.35);
}

.userstuff em,
.userstuff i {
  background: rgba(255, 112, 67, 0.30);
  padding: 0 0.15em;
  border-radius: 6px 3px 8px 2px;
  font-style: italic;
}

.userstuff .notes p,
.userstuff .summary p,
.preface .notes p {
  background: none;
  transform: none;
  padding: 0;
}

.userstuff {
  overflow: visible;
}